# =====================================================================
# TAFLOW — variáveis de ambiente
# Copie para .env.local (dev) e configure no painel do Vercel (produção).
# =====================================================================

# Supabase — novo modelo de chaves (publishable / secret)
# Settings -> API Keys no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Segredo — SOMENTE no servidor, nunca exposto no cliente
SUPABASE_SECRET_KEY=

# URL pública do app. Dev: http://localhost:3000 · Prod: https://SEU-DOMINIO
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth (Calendar). Client em APIs & Services -> Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Precisa bater EXATAMENTE com um Authorized redirect URI no OAuth client.
# Dev: http://localhost:3000/api/gcal/callback
# Prod: https://SEU-DOMINIO/api/gcal/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gcal/callback

# Opcional (só produção com HTTPS público): ativa o webhook em tempo real
# (events.watch). Sem isso, a sincronização de entrada roda por polling.
# Prod: https://SEU-DOMINIO/api/gcal/webhook
GOOGLE_WEBHOOK_URL=

# E-mails com acesso ao painel da plataforma (/admin), separados por vírgula.
# Só o dono da plataforma (você). Não é NEXT_PUBLIC (fica no servidor).
#
# OBRIGATÓRIA EM PRODUÇÃO. Sem ela ninguém entra no painel — nem o dono —, e
# o item "Plataforma" some do menu sem explicar por quê. O servidor passou a
# avisar no log quando ela falta.
PLATFORM_ADMIN_EMAILS=

# Segredo do cron da Vercel. A rota /api/cron/* exige o cabeçalho
# "Authorization: Bearer $CRON_SECRET" e responde 401 quando a variável não
# existe — fecha em vez de abrir. A Vercel envia esse cabeçalho sozinha nos
# jobs do projeto quando a variável está configurada.
CRON_SECRET=


# Cifra das credenciais de terceiros guardadas por empresa (conta de
# recebimento — Mercado Pago, Asaas). 32 bytes em base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sem ela o servidor RECUSA salvar credencial, em vez de guardar em texto
# claro. Perder esta chave torna as credenciais já salvas ilegíveis — os
# clientes precisariam reconectar. Guarde junto com os outros segredos.
CREDENTIAL_ENCRYPTION_KEY=

# Acesso de suporte: liga o "Acessar como suporte" do painel de administração
# e assina o cookie que mostra a faixa e limita o prazo da sessão. Sem ele o
# recurso não existe — fecha em vez de abrir. Mínimo de 16 caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Trocar este valor derruba todas as sessões de suporte abertas, que é como
# se corta o acesso às pressas.
SUPPORT_ACCESS_SECRET=

# ---------------------------------------------------------------------------
# Cobrança do SaaS
# ---------------------------------------------------------------------------

# Provedor de pagamento das faturas que VOCÊ emite para seus clientes.
#   ausente | manual  -> a fatura nasce no sistema sem QR code. Você envia a
#                        cobrança por fora e registra o pagamento no painel,
#                        o que empurra o acesso. Fecha o ciclo sem credencial.
#   fake             -> só fora de produção E com BILLING_FAKE_OK=1. As duas
#                        travas juntas para uma variável esquecida não fazer o
#                        sistema dizer que recebeu dinheiro que não entrou.
BILLING_PROVIDER=manual

# LIGA A COBRANÇA AUTOMÁTICA do cron diário. Sem ela, o cron roda, calcula e
# só ESCREVE NO LOG o que faria — dá para acompanhar por semanas antes de
# emitir a primeira fatura de verdade. Ligue quando conferir que a simulação
# cobraria as pessoas certas.
# BILLING_AUTO=1

# Autentica os crons da Vercel (limpeza de anexos e cobrança). Sem ele as
# rotas ficam FECHADAS, não abertas:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CRON_SECRET=

# Autoriza o webhook de pagamento (/api/webhooks/pagamento/<provedor>).
# Sem ele a rota responde 503 e não faz nada — fechada, como os crons. Um
# webhook de pagamento aberto aceita "está pago" de qualquer um na internet,
# e o prejuízo é acesso liberado sem dinheiro entrar.
#
# No Asaas, este mesmo valor vai no campo de token do painel dele. No Mercado
# Pago ele é a chave que assina o corpo (HMAC-SHA256). Mínimo de 16
# caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# BILLING_WEBHOOK_SECRET=
